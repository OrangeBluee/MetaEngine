\name{MetaEngine-statistics}
\alias{MetaEngine-statistics}
\alias{pm_differential}
\alias{pm_differential_dream}
\title{MetaEngine statistics functions}
\description{Experimental wrappers for covariate-adjusted differential models using limma and variancePartition.}
\details{The limma wrapper constructs a design matrix from the supplied formula, supports contrasts and repeated-observation blocks, and reports moderated tests. The dream wrapper provides a separate mixed-model interface. The statistics module is developed independently; sample alignment, design rank, contrast estimability, and model assumptions require validation for each analysis.}
\keyword{internal}

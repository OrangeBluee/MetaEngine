\name{MetaEngine-workflow}
\alias{MetaEngine-workflow}
\alias{pm_run}
\title{MetaEngine workflow functions}
\description{Coordinate feature-table preprocessing, differential analysis, optional annotation, and result export through \code{pm_run()}.}
\details{Annotation options include local compound libraries, MS-DIAL evidence, independent metabolite-database matching, and local context tables. Common annotation fields are added to the results while source-specific fields remain available. Feature tables use \code{mz_time}; the compatibility argument is \code{feature_id_col = "mz_time"}.}
\keyword{internal}
